<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agentdoc.agent.mapper.SkillVersionMapper">

    <select id="selectReferencedStorageKeys" resultType="java.lang.String">
        SELECT storage_key
        FROM skill_version
        WHERE storage_key IS NOT NULL
          AND TRIM(storage_key) != ''
        ORDER BY id
    </select>
</mapper>
