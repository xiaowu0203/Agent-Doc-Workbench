# ===== Agent-Doc-Workbench 环境变量模板 =====
# 复制为 .env 后按需填写，严禁提交真实凭证

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=agent_doc_workbench
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- MinIO ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=agent-doc

# --- Nacos ---
NACOS_HOST=localhost
NACOS_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_GRPC_TLS_PORT=9849

# --- JWT (RSA 密钥对路径，生产环境使用) ---
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=

# --- Agent Server / A2A / MCP ---
AGENT_SERVICE_PORT=8084
AGENT_SERVICE_URL=http://localhost:8084
AGENT_PUBLIC_URL=http://localhost:9090
TASK_CALLBACK_URL=http://localhost:8083/api/task/internal/a2a/events
MCP_SERVER_URL=http://localhost:8083/mcp
A2A_RECONCILE_DELAY_MS=60000
A2A_RECONCILE_STALE_SECONDS=120
A2A_RECONCILE_BATCH_SIZE=50
# Base64 编码的 16/24/32 字节 AES 密钥，分别用于模型凭证和任务能力令牌
AGENT_CONFIG_KEY=
TASK_CAPABILITY_KEY=
OPENAI_API_KEY=
