# ===== Agent-Doc-Workbench 环境变量模板 =====
# 复制为 .env 后按需填写，严禁提交真实凭证

# --- Spring 运行环境 ---
# 本地开发保持为空；生产部署设置为 prod，启用生产安全配置（包括 Secure、SameSite=Strict Cookie）
SPRING_PROFILES_ACTIVE=

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=agent_doc_workbench
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- MinIO ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=agent-doc
MINIO_AUTO_CREATE_BUCKET=true

# --- Nacos ---
NACOS_HOST=localhost
NACOS_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_GRPC_TLS_PORT=9849
# Nacos 官方镜像要求显式提供以下三项；示例值仅用于本地开发，生产环境必须替换
NACOS_AUTH_TOKEN=VGhpc0lzTXlDdXN0b21TZWNyZXRLZXkwMTIzNDU2Nzg=
NACOS_AUTH_IDENTITY_KEY=agent-doc-workbench
NACOS_AUTH_IDENTITY_VALUE=local-development

# --- JWT（RSA PEM 文本，生产环境必须提供；仅供受信任的进程环境使用） ---
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# --- 身份模式（OIDC接线尚在实施，正式Gateway尚未切换） ---
WORKBENCH_AUTH_MODE=local
# 显式使用oidc时，由受信Keycloak realm及其workbench-api机密客户端提供。
WORKBENCH_AUTH_OIDC_ISSUER=
WORKBENCH_AUTH_OIDC_INTROSPECTION_URI=
WORKBENCH_AUTH_OIDC_INTROSPECTION_CLIENT_ID=workbench-api
WORKBENCH_AUTH_OIDC_INTROSPECTION_CLIENT_SECRET=
# 业务服务调用Auth本人身份接口；跨主机需HTTPS或已确认的受信加密网络。
AGENT_DOC_FEIGN_IDENTITY_AUTH_URL=http://localhost:8081
AGENT_DOC_FEIGN_IDENTITY_TRUSTED_ENCRYPTED_NETWORK=false

# --- P0 Task内部调用（Task/Auth/Agent三服务配置一致；独立随机文本，至少32字节） ---
# 为空/过短时内部签发与执行档案入口拒绝服务；不复用JWT/恢复/模型密钥。
TASK_INTERNAL_AUTH_SECRET=
TASK_INTERNAL_AUTH_URL=http://localhost:8081
TASK_INTERNAL_AGENT_URL=http://localhost:8084
# 跨主机使用HTTPS；只有已确认受信加密内部网络时才设true，本机回环HTTP不需要。
TASK_INTERNAL_TRUSTED_ENCRYPTED_NETWORK=false

# --- Agent Server / A2A / MCP ---
AGENT_SERVICE_PORT=8084
AGENT_SERVICE_URL=http://localhost:8084
AGENT_PUBLIC_URL=http://localhost:9090
AGENT_MODEL_READ_TIMEOUT=600s
TASK_CALLBACK_URL=http://localhost:8083/api/task/internal/a2a/events
MCP_SERVER_URL=http://localhost:8083/mcp
A2A_RECONCILE_DELAY_MS=60000
A2A_RECONCILE_STALE_SECONDS=120
A2A_RECONCILE_BATCH_SIZE=50
# Base64 编码的 16/24/32 字节 AES 密钥，分别用于模型凭证和任务能力令牌
AGENT_CONFIG_KEY=
TASK_CAPABILITY_KEY=
OPENAI_API_KEY=

# --- Evaluation WorkerCapability（Base64 编码的 16/24/32 字节 AES 密钥） ---
EVALUATION_SERVICE_PORT=8085
EVALUATION_CAPABILITY_KEY_VERSION=v1
EVALUATION_CAPABILITY_KEY=
# Agent 与 Evaluation 共享的独立报告证明密钥，Base64 编码至少 32 随机字节。
EXPERIMENT_REPORT_PROOF_KEY=

# --- Skill selection ---
SKILL_ROUTER_MAX_SELECTED=5
SKILL_ROUTER_TIMEOUT=8s
SKILL_ROUTER_MAX_OUTPUT_TOKENS=256
