<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.agentdoc</groupId>
        <artifactId>agent-doc-workbench</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>agent-doc-evaluation-service</artifactId>
    <name>agent-doc-evaluation-service</name>
    <description>Dataset、Replay 编排与确定性评估服务</description>

    <dependencies>
        <!-- Spring Boot 基础组件 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ORM & DB -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- OpenAPI 文档 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- 内部公共模块 -->
        <dependency>
            <groupId>com.agentdoc</groupId>
            <artifactId>agent-doc-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.agentdoc</groupId>
            <artifactId>agent-doc-common-security-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.agentdoc</groupId>
            <artifactId>agent-doc-common-web-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.agentdoc</groupId>
            <artifactId>agent-doc-common-springdoc-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.agentdoc</groupId>
            <artifactId>agent-doc-common-mybatis-plus-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.agentdoc</groupId>
            <artifactId>agent-doc-common-redis-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.agentdoc</groupId>
            <artifactId>agent-doc-common-feign-spring-boot-starter</artifactId>
        </dependency>

        <!-- 编译期工具 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
